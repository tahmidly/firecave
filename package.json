{
  "name": "localclaw",
  "version": "0.1.0",
  "description": "Firecave: a local desktop home for your AI coding CLIs",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron \"next dev -p 3210\" \"wait-on tcp:3210 && npm run build:electron && cross-env LOCALCLAW_DEV=1 electron .\"",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron",
    "build:web": "next build",
    "start": "npm run build:web && npm run build:electron && electron .",
    "lint": "echo no-lint-configured",
    "dist": "npm run build:all && electron-builder",
    "make:icon": "electron scripts/make-icon.cjs",
    "build:all": "npm run build:web && npm run build:electron",
    "dist:win": "npm run build:all && electron-builder --win nsis",
    "dist:mac": "npm run build:all && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ibm/plex-mono": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "app.firecave.desktop",
    "productName": "Firecave",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "out/**",
      "build/icon.*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Firecave"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Firecave ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  },
  "author": "Firecave"
}